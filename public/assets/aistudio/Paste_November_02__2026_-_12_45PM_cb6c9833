val BgColor = Color(0xFF080812)
val PanelColor = Color(0xFF151526)
val PurpleAccent = Color(0xFF9B5CFF)
val CyanAccent = Color(0xFF54D8FF)
val GreenSuccess = Color(0xFF00C853)
val RedError = Color(0xFFD50000)

class MainViewModel : ViewModel() {
    var orbColor by mutableStateOf(PurpleAccent)
    var recognizedText by mutableStateOf("Say something...")
    var jobsList by mutableStateOf(listOf<Job>())

    fun processCommand(command: String, tts: TextToSpeech?, jobSearchService: JobSearchService) {
        recognizedText = command
        orbColor = PurpleAccent // Searching state
        
        val lowerCmd = command.lowercase()
        if (lowerCmd.contains("canada") && lowerCmd.contains("farm worker")) {
            // Simulated Coroutine launch
            orbColor = GreenSuccess // Found state
            tts?.speak("Canada me Farm Worker ki jobs dhoond li hain", TextToSpeech.QUEUE_FLUSH, null, null)
        } else if (lowerCmd.contains("resume banao")) {
            tts?.speak("Resume tailor kiya ja raha hai", TextToSpeech.QUEUE_FLUSH, null, null)
        } else {
            orbColor = RedError // Error state
            tts?.speak("Samajh nahi aaya, dobara koshish karein", TextToSpeech.QUEUE_FLUSH, null, null)
        }
    }
}

class MainActivity : ComponentActivity(), TextToSpeech.OnInitListener {
    private var tts: TextToSpeech? = null
    private lateinit var viewModel: MainViewModel
    
    private val speechRecognizerLauncher = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
        if (result.resultCode == Activity.RESULT_OK) {
            val data = result.data?.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS)
            data?.get(0)?.let { command ->
                viewModel.processCommand(command, tts, JobSearchService(SharedPrefsHelper(this)))
            }
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        tts = TextToSpeech(this, this)
        
        setContent {
            viewModel = viewModel()
            MaterialTheme(colorScheme = darkColorScheme(background = BgColor, surface = PanelColor, primary = PurpleAccent)) {
                MainScreen(viewModel) { startListening() }
            }
        }
    }

    private fun startListening() {
        val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
            putExtra(RecognizerIntent.EXTRA_LANGUAGE, "ur-PK")
        }
        speechRecognizerLauncher.launch(intent)
    }

    override fun onInit(status: Int) {
        if (status == TextToSpeech.SUCCESS) {
            tts?.language = Locale("hi", "IN") // Hinglish/Urdu fallback
        }
    }
    
    override fun onDestroy() {
        tts?.shutdown()
        super.onDestroy()
    }
}

