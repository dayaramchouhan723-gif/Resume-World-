Strict anti-fake resume generation using Gemini. Outputs PDF via Android Canvas.
code
Kotlin
// File: app/src/main/java/com/dayaram/resumeworld/ResumeTailorEngine.kt
package com.dayaram.resumeworld

import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.pdf.PdfDocument
import com.google.ai.client.generativeai.GenerativeModel
import java.io.File
import java.io.FileOutputStream

class ResumeTailorEngine(private val context: Context, private val sharedPrefsHelper: SharedPrefsHelper) {

    suspend fun generateTailoredResume(baseResume: String, jobDesc: String): String {
        val apiKey = sharedPrefsHelper.getGeminiKey() ?: throw Exception("Gemini API Key missing")
        val generativeModel = GenerativeModel(modelName = "gemini-1.5-flash", apiKey = apiKey)

        val prompt = """
            You are ATS Resume Expert. Compare base resume vs job description. 
            1. List 5-7 missing keywords/skills. 
            2. Rewrite resume using ONLY existing experience, reword to match keywords. 
            RULES: NEVER invent fake jobs, fake degrees, fake certificates. If skill missing, suggest learning in Gap Analysis, do NOT add as possessed. 
            3. Output JSON: { "gapAnalysisUrdu": "...", "tailoredResumeText": "...", "estimatedMatchBefore": "...", "estimatedMatchAfter": "..." }. 
            Label estimated as ESTIMATE not guarantee. 
            Format: Single-column Canadian ATS. Base Resume: $baseResume. Job: $jobDesc.
        """.trimIndent()

        val response = generativeModel.generateContent(prompt)
        return response.text ?: "{}"
    }

    fun generatePdf(tailoredText: String, fileName: String): String {
        val pdfDocument = PdfDocument()
        val pageInfo = PdfDocument.PageInfo.Builder(595, 842, 1).create() // A4 Size
        val page = pdfDocument.startPage(pageInfo)
        
        val canvas: Canvas = page.canvas
        val paint = Paint().apply {
            color = Color.BLACK
            textSize = 12f
        }

        var yPos = 50f
        tailoredText.split("\n").forEach { line ->
            if (yPos > 800) { /* Handle multi-page in full version */ }
            canvas.drawText(line, 50f, yPos, paint)
            yPos += 15f
        }

        pdfDocument.finishPage(page)
        val file = File(context.filesDir, "$fileName.pdf")
        pdfDocument.writeTo(FileOutputStream(file))
        pdfDocument.close()
        
        return file.absolutePath
    }
}
