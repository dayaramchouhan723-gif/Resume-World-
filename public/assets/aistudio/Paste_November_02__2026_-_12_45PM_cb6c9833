package com.dayaram.resumeworld

import android.content.Context
import androidx.room.*
import kotlinx.coroutines.flow.Flow

@Entity(tableName = "user_profile")
data class UserProfileEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val name: String,
    val email: String,
    val phone: String,
    val skills: String,
    val experience: String,
    val education: String,
    val baseResumePath: String
)

@Entity(tableName = "applied_jobs")
data class AppliedJobsEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val company: String,
    val role: String,
    val dateApplied: Long,
    val status: String,
    val resumePath: String,
    val jobLink: String
)

@Entity(tableName = "vault")
data class VaultEntity(
    @PrimaryKey(autoGenerate = true) val id: Int = 0,
    val documentName: String,
    val filePath: String,
    val extractedText: String
)

@Dao
interface AppDao {
    @Query("SELECT * FROM applied_jobs ORDER BY dateApplied DESC")
    fun getAllAppliedJobs(): Flow<List<AppliedJobsEntity>>
    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertAppliedJob(job: AppliedJobsEntity)
    
    @Query("SELECT * FROM vault")
    fun getVaultDocs(): Flow<List<VaultEntity>>
    @Insert
    suspend fun insertVaultDoc(doc: VaultEntity)
}

@Database(entities = [UserProfileEntity::class, AppliedJobsEntity::class, VaultEntity::class], version = 1)
abstract class AppDatabase : RoomDatabase() {
    abstract fun appDao(): AppDao

    companion object {
        @Volatile private var INSTANCE: AppDatabase? = null
        fun getDatabase(context: Context): AppDatabase {
            return INSTANCE ?: synchronized(this) {
                Room.databaseBuilder(context.applicationContext, AppDatabase::class.java, "resumeworld_db")
                    .build().also { INSTANCE = it }
            }
        }
    }
}
